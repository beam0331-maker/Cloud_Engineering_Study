package exam2.insert;

import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.SQLException;

public class DeptServiceImpl implements DeptService{
	
	DeptDAO dao;
	
	String driver = "com.mysql.cj.jdbc.Driver"; // 핵심이 되는 클래스명
    String url = "jdbc:mysql://localhost:3306/testdb";
    String userid ="root";
    String passwd = "1234";
	
    // [회고포인트] 왜 드라이버 로딩은 생성자로 연결하는가
	public DeptServiceImpl() {
		try { 
			Class.forName(driver);
		} catch (ClassNotFoundException e) {
			System.err.println("driver : " + e.getMessage());
		}
	}// end 생성자

	public void setDao(DeptDAO dao) {
		this.dao = dao;
	}
	
	public void insert(DeptDTO dto) {
		Connection con = null;
		
		
		try {
			con = DriverManager.getConnection(url, userid, passwd);
			dao.insert(con, dto);		
		} catch (SQLException e) {
			System.err.println("DriverManager err : " + e.getMessage());
		}		
		
		
	}// method end
	
}// class end
