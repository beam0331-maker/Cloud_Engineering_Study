<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="p2.EmpMapper">  
	
	<resultMap id="empdeptjoin2Map" type="">
	</resultMap>
	
	
	<select id="empdeptjoin2" resultMap="empdeptjoin2Map">
		select *
		from emp join dept on emp.deptno = dept.deptno
		order by empno desc
	</select>

</mapper>