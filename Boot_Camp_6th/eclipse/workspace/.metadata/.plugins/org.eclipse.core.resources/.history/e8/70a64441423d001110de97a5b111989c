package exam2.finalproject;

import java.util.List;
import java.util.Scanner;

import exam2.delete.DeptDAO;
import exam2.delete.DeptService;
import exam2.delete.DeptServiceImpl;

// 화면처리 담당
// DepService와 연동
public class DeptMain {

	public static void main(String[] args) {

		Scanner sc = new Scanner(System.in);
		while (true) {
			System.out.print("""
					=======================================
					0. 종료
					1. 부서 목록보기
					2. 부서 추가
					3. 부서 삭제
					4. 부서 수정
					=======================================
					""");
			System.out.print("번호 입력 =>  ");
			// 번호 읽기
			String cmd = sc.next();

			if (cmd.equals("1")) {
				
				// 부서 목록보기
				DeptService service = new DeptServiceImpl();
				service.setDao(new DeptDAO());
				List<DeptDTO> list = service.list();
				System.out.println("=======================================");
				System.out.println("부서번호\t부서명\t\t부서위치");
				System.out.println("=======================================");
				for (DeptDTO dto : list) {
					System.out.printf("%d	%-8s	%s\n",dto.getDeptno(),dto.getDname(),dto.getLoc());
				}
				
			} else if (cmd.equals("2")) {
				System.out.println("=======================================");
				System.out.print("부서번호를 입력하시오 : ");
				int deptno = sc.nextInt();
				System.out.print("부서명를 입력하시오 : ");
				String dname = sc.next();
				System.out.print("부서위치를 입력하시오 : ");
				String loc = sc.next();
				System.out.println("=======================================");
				DeptService service = new DeptServiceImpl();
				service.setDao(new DeptDAO());		

				DeptDTO dto = new DeptDTO(deptno, dname, loc);
				
				try {
					int n = service.insert(dto);
					if (n >= 1)
						System.out.println("저장성공");
					
				} catch (DuplicatedDeptnoException e) {
					System.out.println(e.getMessage()); 
				}
				
			
			} else if (cmd.equals("3")) {
				
				
				System.out.print("삭제할 부서번호를 입력하시오 : ");
				int deptno = sc.nextInt();
				DeptService service = new DeptServiceImpl();
				service.setDao(new DeptDAO());
				try {
					int n = service.delete(deptno);
					if (n >= 1)
						System.out.println("삭제성공");
				} catch (RecordNotFoundExecpiton e) {
					System.out.println(e.getMessage());
				}
				
			} else if (cmd.equals("4")) {
				System.out.println("=======================================");
				System.out.print("수정할 부서번호를 입력하시오 : ");
				int deptno = sc.nextInt();
				System.out.print("수정할 부서명를 입력하시오 : ");
				String dname = sc.next();
				System.out.print("수정할 부서위치를 입력하시오 : ");
				String loc = sc.next();
				System.out.println("=======================================");
				
				DeptService service = new DeptServiceImpl();
				service.setDao(new DeptDAO());
				
				DeptDTO dto = new DeptDTO(deptno, dname, loc);
				int n = service.update(dto); 
				if (n >= 1)
					System.out.println("수정성공");	
				
			} else {
				sc.close();
				System.out.println("프로그램 종료");
				System.exit(1);
			} // if-elseif end
			
			
		}// while end

		
	}

}
