<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.config.EmpMapper">  
   <!-- 멀티 insert-->
   <insert id="insertMulti" parameterType="arraylist">
   		insert into emp(empno,ename,sal)
   		values
   		<foreach item="dto" separator="," collection="list">
   			(#{dto.empno},#{dto.ename},#{dto.sal})
   		</foreach>
   </insert>
   
   <delete id="deleteMulti" parameterType="arraylist">
   		delete from emp
   		<where>
   			<foreach item="num" separator="," open="empno in (" close=")" collection="list">
   				#{num}
   			</foreach>
   		</where>
   </delete> 
     
 	<select id="selectMulti" parameterType="arraylist" resultType="EmpDTO">
	       select empno,ename,sal
	       from emp
	   <where>
	   <foreach item="ename"  separator="," collection="list" open=" ename IN (" close=")">
			 #{ename}
	    </foreach>
	   </where>
	 </select>


	<select id = "selectif" parameterType = "EmpDTO" resultType="EmpDTO">						
		select empno, ename, ename, sal, job
		from emp
		<where>
			<if test="job != null">
				job = #{job}
			</if>
		</where>	
	</select>
	
	<select id = "selectif2" parameterType="EmpDTO" resultType="EmpDTO">						
		select empno, ename, ename, sal, job
		from emp
		<where>
			<if test="job != null">
				job = #{job}
			</if>
			<if test="sal != 0">
				and sal = #{sal}
			</if>
		</where>	
	</select>
	
	<update id="updateIf" parameterType="EmpDTO" >
		 update emp
		    <set>
			    <if test="mgr != 0"> mgr=#{mgr},   </if>
			    <if test="ename != null"> ename  = #{ename}, </if>
			    <if test="sal != 0"> sal = #{sal} </if>
		    </set>
		    where empno=#{empno}
	</update> 	 
	
	<!-- choose 실습-->
	<select id="selectChoose" parameterType="EmpDTO" resultType="EmpDTO">
		select empno, ename, ename, sal, job
		from emp
		<where>
			<choose>
				<when test="job == 'SALESMAN'">
					sal &gt; 1500
				</when>
				<when test="job == 'CLERK'">
					sal &gt; 2500
				</when>
				<otherwise>
					sal &gt; 3000
				</otherwise>
			</choose>				
		</where>				
	</select>
	
	<!-- 단일 컬럼-->
	<select id="singleColumn" resultType="int">
		select count(*)
		from emp;
	</select>

	
	
	<!--페이징-->>
	<select id="paging" resultType="EmpDTO">		
		select empno,ename,sal
		from emp
		ORDER BY empno desc
	</select>
	   
</mapper>