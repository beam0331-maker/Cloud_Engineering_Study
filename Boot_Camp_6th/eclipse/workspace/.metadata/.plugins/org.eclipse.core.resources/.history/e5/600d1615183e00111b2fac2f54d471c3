package com.dto;

// dept 테이블의 컬럼 저장 ( 레코드 저장 )
public class DeptDTO {
	
	// 컬럼명으로 변수명을 사용하자.
	int deptno;
	String dename;
	String loc;

	//필수: 기본생성자
	public DeptDTO() {}

	public DeptDTO(int deptno, String danme, String loc) {
		this.deptno = deptno;
		this.dename = danme;
		this.loc = loc;
	}
	
	// 필수: getter / setter
	public int getDeptno() {
		return deptno;
	}

	public void setDeptno(int deptno) {
		this.deptno = deptno;
	}

	public String getDename() {
		return dename;
	}

	public void setDename(String danme) {
		this.dename = danme;
	}

	public String getLoc() {
		return loc;
	}

	public void setLoc(String loc) {
		this.loc = loc;
	}

	@Override
	public String toString() {
		return "DeptDTO [deptno=" + deptno + ", dename=" + dename + ", loc=" + loc + "]";
	}
	
	
}
