<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.config.EmpMapper">  

	<select id="findaAll" resultType="Emp">
		select empno,
			   ename as username,
			   job,
			   mgr,
			   hiredate,
			   sal,
			   comm as commission,
			   deptno				
		from emp
		order by empno desc
	</select>	   

</mapper>